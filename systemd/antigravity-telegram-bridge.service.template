[Unit]
Description=Antigravity Telegram Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__HOME__/.gemini/extensions/antigravity-telegram-bridge
ExecStart=__VENV_PYTHON__ -m src.daemon
Environment=PYTHONUNBUFFERED=1
Environment=AGY_BRIDGE_HEALTH_PORT=9100
Environment=PATH=__HOME__/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Restart=on-failure
RestartSec=5s

# --- Hardening (mirrors kimi-telegram-bridge) ---
# NOTE: RestrictAddressFamilies, RestrictSUIDSGID, NoNewPrivileges, and
# SystemCallFilter are intentionally omitted. This bridge spawns `agy`
# with --dangerously-skip-permissions, which is used for arbitrary
# sysadmin/network tasks (apt-get install, nmap scans, etc.) chosen by
# whatever the Telegram user asks for. A syscall allowlist is
# fundamentally incompatible with that: it broke on fchown (exit=-31 /
# SIGSYS) the first time `agy` touched file ownership, and would keep
# breaking unpredictably on the next syscall an arbitrary shell command
# happens to need. NoNewPrivileges would similarly break setuid tools
# (sudo, older ping) that such commands may rely on. Re-evaluate if the
# bridge's use case narrows to something that doesn't need arbitrary
# root shell access.
SystemCallArchitectures=native
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
UMask=0077

StandardOutput=append:__HOME__/.antigravity/bridge/logs/bridge.log
StandardError=append:__HOME__/.antigravity/bridge/logs/bridge.log

[Install]
WantedBy=default.target
